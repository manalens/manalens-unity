# Unity makes these when it opens the project.
/Library/
/Temp/
/Logs/
/UserSettings/
# Keep ProjectVersion.txt: without it, Unity treats a new checkout as a new project and
# adds its default packages to Packages/manifest.json.
/ProjectSettings/*
!/ProjectSettings/ProjectVersion.txt
/Packages/packages-lock.json
/Assets/E2E/E2E.unity
*.meta
*.csproj
*.sln
