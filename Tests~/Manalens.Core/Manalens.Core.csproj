<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the engine-independent core (Runtime/Core) outside Unity, with
       the same target and language level as Unity 2021.3 (.NET Standard 2.1, C# 9). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Manalens.Core</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Runtime/Core/**/*.cs" />
  </ItemGroup>
</Project>
